# Copy to `.env.local` for local development. Next.js exposes only variables
# prefixed with NEXT_PUBLIC_ to the browser.

# Base URL of the Routiq API, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# For a deployed API use the public origin, e.g.
# NEXT_PUBLIC_API_URL=https://routiq-logistics-and-delivery.onrender.com/api/v1
