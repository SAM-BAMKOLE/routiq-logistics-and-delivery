# Copy to .env and adjust. All values have sensible defaults for local dev.

# Base URL of the Routiq API (including the version prefix).
ROUTIQ_API_URL=http://localhost:3000/api/v1

# Path to the manifest written by `pnpm db:seed:demo` in the api package.
# Defaults to ../api/.demo-seed.json relative to this package.
# ROUTIQ_SEED_MANIFEST=../api/.demo-seed.json

# Password shared by every seeded demo account (informational fallback when
# no manifest is found).
ROUTIQ_DEMO_PASSWORD=Passw0rd!demo

# Simulation behaviour
# ROUTIQ_BOT_ROUNDS=1
# ROUTIQ_BOT_INTERVAL_SECONDS=15
