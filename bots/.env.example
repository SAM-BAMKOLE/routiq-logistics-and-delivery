# --- Target API ---
# Base URL of the API the bots drive. Defaults to the manifest's apiBaseUrl,
# then http://localhost:3000/api/v1.
ROUTIQ_API_URL=http://localhost:3000/api/v1

# --- Seed manifest ---
# Either a path to the file written by `pnpm db:seed:demo` in ../api ...
ROUTIQ_SEED_MANIFEST=../api/.demo-seed.json
# ... or the manifest as inline JSON (wins if both are set). Useful in CI where
# the manifest is a secret and writing a file is pointless.
# ROUTIQ_SEED_MANIFEST_JSON={"generatedAt":"...","companies":[...]}

# Shared password for every seeded demo account.
ROUTIQ_DEMO_PASSWORD=Passw0rd!demo

# --- Run shape ---
# Rounds to run: 1 = one lifecycle per company, 0 = loop until Ctrl+C.
ROUTIQ_BOT_ROUNDS=1
# Pause between rounds, in seconds.
ROUTIQ_BOT_INTERVAL_SECONDS=15

# --- Resilience to a sleeping free-tier host ---
# How long to wait for the API to boot before giving up this run, in seconds.
ROUTIQ_BOT_WARMUP_SECONDS=300
# Attempts per request on transient failures (network, 429, 502, 503, 504).
ROUTIQ_BOT_HTTP_RETRIES=6
# Per-attempt request timeout, in milliseconds.
ROUTIQ_BOT_HTTP_TIMEOUT_MS=30000
