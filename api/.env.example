# Copy to .env and fill in real values. This file is safe to commit; .env is not.
# The app validates this schema at boot and refuses to start with missing or
# malformed values.

# Environment: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000

# Version prefix for public routes (health and docs stay at the root)
API_PREFIX=/api/v1

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated allow-list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Database — application runtime role. Subject to Row Level Security; it can
# only read/write rows for the active tenant and cannot run DDL.
DATABASE_URL=postgresql://ldms_app:ldms_app@localhost:5432/ldms

# Database — migration/owner role. Owns the tables and runs DDL. Only the
# TypeORM CLI reads this; the application never connects as this role.
MIGRATION_DATABASE_URL=postgresql://ldms_owner:ldms_owner@localhost:5432/ldms

# Authentication — HMAC secret signing the short-lived JWT access tokens.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# Access-token lifetime (default 15m) and refresh-token lifetime in days
# (default 30). Rotation happens on every refresh-token use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Email transport: gmail | console | memory
#   gmail   - Nodemailer over smtp.gmail.com:465 (staging/demo)
#   console - print rendered messages to the log (local development)
#   memory  - collect in memory for tests
# Defaults to memory under NODE_ENV=test, console otherwise. Selecting
# gmail without SMTP_USER/SMTP_PASSWORD fails the app at boot.
EMAIL_ADAPTER=console

# Gmail App Password (create one with 2-Step Verification enabled; never
# reuse the account password). Required only when EMAIL_ADAPTER=gmail.
# Rotation: revoke the App Password in Google Account > Security and
# update this value.
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=

# Daily send ceilings: a personal Gmail account allows ~500 messages/day.
# The global limit keeps headroom below that; the per-tenant share stops
# one tenant consuming the shared allowance. Critical mail ignores both.
EMAIL_DAILY_GLOBAL_LIMIT=450
EMAIL_DAILY_TENANT_LIMIT=100

# Base URL for links in outgoing email (invitations, password resets)
APP_BASE_URL=http://localhost:5173