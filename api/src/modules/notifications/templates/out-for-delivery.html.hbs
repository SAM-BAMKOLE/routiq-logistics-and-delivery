{{#> layout}}
<h2 style="margin:0 0 12px;font-size:20px;color:{{accentColor}};">Out for delivery</h2>
<p style="margin:0 0 12px;line-height:1.5;">
  Hi {{customerName}},
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  Shipment <strong>{{trackingNumber}}</strong> is out for delivery and
  should arrive today. Keep your phone handy in case the driver needs you.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">
  Tracking number: <strong>{{trackingNumber}}</strong>
</p>
{{/layout}}