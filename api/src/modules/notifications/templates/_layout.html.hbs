<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:100%;max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;">
        {{#if logoUrl}}
        <tr>
          <td align="center" style="padding:24px 24px 0;">
            <img src="{{logoUrl}}" alt="{{tenantName}}" style="max-height:48px;">
          </td>
        </tr>
        {{/if}}
        <tr>
          <td style="padding:24px;">
            {{> @partial-block}}
            <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 12px;">
            <p style="font-size:12px;color:#6b7280;margin:0;">
              Sent by {{tenantName}} &mdash; logistics powered by LDMS.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
