{{#> layout}}
<h2 style="margin:0 0 12px;font-size:20px;color:{{accentColor}};">Out for delivery</h2>
<p style="margin:0 0 12px;line-height:1.5;">
  Hi {{customerName}},
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  Your shipment <strong>{{trackingNumber}}</strong> is out for delivery.
  Share this code with the driver when the parcel arrives:
</p>
<p style="margin:0 0 12px;font-size:28px;letter-spacing:6px;font-weight:700;color:#111827;">
  {{code}}
</p>
<p style="margin:0 0 12px;font-size:14px;color:#6b7280;">
  The code works for {{ttlHours}} hours and can be used once. If it expires,
  reply to your dispatch contact for a new one.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">
  Tracking number: <strong>{{trackingNumber}}</strong>
</p>
{{/layout}}
