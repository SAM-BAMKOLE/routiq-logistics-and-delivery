{{#> layout}}
<h2 style="margin:0 0 12px;font-size:20px;color:{{accentColor}};">Shipment confirmed</h2>
<p style="margin:0 0 12px;line-height:1.5;">
  Hi {{customerName}},
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  Good news — your shipment <strong>{{trackingNumber}}</strong> has been
  confirmed and is being prepared for pickup. We'll let you know as soon
  as a driver is assigned.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">
  Tracking number: <strong>{{trackingNumber}}</strong>
</p>
{{/layout}}
