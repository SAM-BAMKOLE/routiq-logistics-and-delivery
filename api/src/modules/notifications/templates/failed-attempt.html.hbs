{{#> layout}}
<h2 style="margin:0 0 12px;font-size:20px;color:{{accentColor}};">Delivery attempt failed</h2>
<p style="margin:0 0 12px;line-height:1.5;">
  Hi {{customerName}},
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  We could not deliver shipment <strong>{{trackingNumber}}</strong>:
  the driver reported <strong>{{reason}}</strong>
  (attempt {{failedAttempts}}).
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  Don't worry - we'll try again. Reply to this email if you'd like to
  arrange something different.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">
  Tracking number: <strong>{{trackingNumber}}</strong>
</p>
{{/layout}}