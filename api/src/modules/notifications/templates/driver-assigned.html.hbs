{{#> layout}}
<h2 style="margin:0 0 12px;font-size:20px;color:{{accentColor}};">Your driver is assigned</h2>
<p style="margin:0 0 12px;line-height:1.5;">
  Hi {{customerName}},
</p>
<p style="margin:0 0 12px;line-height:1.5;">
  A driver has been assigned to shipment <strong>{{trackingNumber}}</strong>
  and will collect it shortly.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">
  Tracking number: <strong>{{trackingNumber}}</strong>
</p>
{{/layout}}
